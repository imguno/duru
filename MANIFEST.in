include LICENSE README.md README.ko.md
recursive-include src *.py *.md
recursive-include tests *.py
recursive-include tools *.py
global-exclude *.py[cod] *.token *.pem *.key .env .env.*
prune .git
prune .venv
prune .runtime
prune .verification
prune .secrets
prune secrets
prune docs
include docs/CONTRIBUTING.md docs/CONTRIBUTING.ko.md
include docs/SECURITY.md docs/SECURITY.ko.md
include docs/RELEASE.md docs/RELEASE.ko.md
prune build
prune dist
global-exclude [Aa][Gg][Ee][Nn][Tt].md [Aa][Gg][Ee][Nn][Tt][Ss].md [Cc][Hh][Aa][Nn][Gg][Ee][Ll][Oo][Gg]*
